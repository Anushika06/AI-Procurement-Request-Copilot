# Local mock service
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001

# LLM (Gemini via its OpenAI-compatible endpoint). Leave the key empty to run in offline mode.
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_TIMEOUT_SECONDS=45

# Set to 1 to force offline mode even when a key is present (deterministic, no LLM calls).
# COPILOT_OFFLINE=0
