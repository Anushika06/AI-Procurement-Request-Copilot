# Local mock service
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001

# Primary LLM: Gemini via its OpenAI-compatible endpoint.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.8-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Optional thinking level for Gemini, sent as reasoning_effort.
# LLM_REASONING_EFFORT=low

# Optional fallback LLM: Groq (used when Gemini hits a quota/availability error).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_REASONING_EFFORT=low

# auto = Gemini first, Groq as fallback. gemini / groq = use only that provider.
LLM_PROVIDER=auto

# LLM_TIMEOUT_SECONDS=60
# LLM_TEMPERATURE=0
# Max seconds to wait on a 429 with a short Retry-After (evals/compare.py sets 65).
# LLM_RATE_LIMIT_WAIT=0
# Minimum seconds between LLM calls (evals/compare.py --rpm sets this).
# LLM_MIN_CALL_INTERVAL=0

# Leave every key empty, or set this to 1, for offline mode (deterministic, no LLM calls).
# COPILOT_OFFLINE=0
